# Supabase. Both of these are PUBLIC and are inlined into the browser bundle.
# That is correct for the anon key: it identifies the project and authorises
# nothing on its own, because the row level security policies in
# supabase/01-schema.sql decide who may read which row.
#
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER put the service role key here. It bypasses row level security entirely,
# and anything prefixed VITE_ ends up readable in devtools. It belongs on the
# server, beside the Anthropic key.

# Server only. Never prefixed VITE_, never sent to the browser.
ANTHROPIC_API_KEY=
