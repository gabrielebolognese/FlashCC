# ── Browser ────────────────────────────────────────────────────────────────
# Anything prefixed VITE_ is inlined into the bundle and readable in devtools.
# That is correct for the publishable key: it identifies the project and
# authorises nothing on its own, because the row level security policies in
# supabase/01-schema.sql decide who may read which row.
#
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# Older projects issue a JWT anon key instead; that name still works:
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Server only ────────────────────────────────────────────────────────────
# None of these are ever prefixed VITE_, and none reach the browser.

# Drafting. Without it the AI step degrades to "write it yourself".
ANTHROPIC_API_KEY=

# Reads and writes profiles.plan. This key BYPASSES row level security
# completely, it is the one thing that can grant a plan, which is exactly why
# the browser must never see it.
# Dashboard, Project Settings, API Keys, "Create secret key" (sb_secret_...).
# The legacy service_role JWT still works and is read as a fallback, but
# Supabase is deprecating it by the end of 2026.
SUPABASE_SECRET_KEY=

# Lemon Squeezy, our merchant of record. They owe the VAT, not us.
# Settings, API, create a key. Test mode is a toggle on the store, not a
# separate key, so check which mode the store is in before charging anybody.
LEMON_API_KEY=
# Settings, Stores. A number.
LEMON_STORE_ID=
# The signing secret you chose when creating the webhook, 6 to 40 characters.
# Without it the webhook route refuses every request, which is the right
# default: an unverified webhook is an open door to a free subscription.
LEMON_WEBHOOK_SECRET=
# VARIANT ids, not product ids. A product holds variants (monthly, yearly) and
# the variant is what a webhook carries. Find them under the product, or at
# /v1/variants in the API.
LEMON_VARIANT_PRO=
LEMON_VARIANT_AGENCY=

# Where the checkout sends people back to when payment succeeds.
PUBLIC_SITE_URL=http://localhost:5173
