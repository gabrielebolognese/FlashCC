# ── Browser ────────────────────────────────────────────────────────────────
# Anything prefixed VITE_ is inlined into the bundle and readable in devtools.
# That is correct for the publishable key: it identifies the project and
# authorises nothing on its own, because the row level security policies in
# supabase/01-schema.sql decide who may read which row.
#
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# Older projects issue a JWT anon key instead; that name still works:
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Server only ────────────────────────────────────────────────────────────
# None of these are ever prefixed VITE_, and none reach the browser.

# Drafting. Without it the AI step degrades to "write it yourself".
ANTHROPIC_API_KEY=

# Writes profiles.plan after a verified Stripe webhook. This key BYPASSES row
# level security completely — it is the one thing that can grant a plan, which
# is exactly why the browser must never see it.
# Dashboard → Project Settings → API → service_role (click to reveal)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Test keys (sk_test_…) until you are actually charging people.
STRIPE_SECRET_KEY=
# From `stripe listen` in dev, or the webhook endpoint's signing secret in prod.
# Without it the webhook route refuses every request, which is the right
# default: an unverified webhook is an open door to a free subscription.
STRIPE_WEBHOOK_SECRET=
# Price ids, not product ids. They start with price_.
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Where Stripe sends people back to after checkout.
PUBLIC_SITE_URL=http://localhost:5173
